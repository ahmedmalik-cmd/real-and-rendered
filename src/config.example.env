# Copy to .env (git-ignored) or set these in the shell before running src/scripts/*.bat.
# The defaults below are what the code uses when a variable is unset.

# RTX 3090 PC: TRIBE v2 server (tribe_server.py) and open_clip server (clip_server.py).
# Use that PC's LAN address, or an ngrok https URL if the LAN route is blocked.
TRIBE_URL=http://localhost:8000
CLIP_URL=http://localhost:8001

# Ollama on the installation PC (LLaVA). Base URL only, no /api/... path.
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llava

# Kinect bridge (src/kinect-bridge) on the installation PC.
# BRIDGE_URL=http://localhost:8182

# Demo mode: watch a webcam index ("0") or a video file instead of the Kinect bridge,
# and keep the room's memory somewhere of your choosing (default: Unity's persistentDataPath).
# ROOM_CAMERA=0
# ROOM_DATA_DIR=./room-data

# Optional, used by src/scripts/*.bat only
# BUILD_EXE=..\..\Builds\DualKinectPointCloud.exe
# BRIDGE_EXE=..\kinect-bridge\bin\Release\ThereminKinectBridge.exe
